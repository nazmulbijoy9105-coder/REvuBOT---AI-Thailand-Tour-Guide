generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Conversation {
  id          String    @id @default(uuid())
  title       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  messages    Message[]
  preference  UserPreference?

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String
  content        String
  aiProvider     String?
  responseTime   Int?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model UserPreference {
  id             String       @id @default(uuid())
  conversationId String       @unique
  budget         String?
  travelStyle    String?
  interests      String[]     @default([])
  dietary        String[]     @default([])
  mobility       String?
  groupType      String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Destination {
  id          Int      @id @default(autoincrement())
  name        String
  category    String
  location    String
  description String
  highlights  String[]
  bestTime    String?
  priceRange  String?
  tips        String?
  rating      Float?   @default(0)
  lat         Float?
  lng         Float?
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([location])
  @@map("destinations")
}
